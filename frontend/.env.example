# Browser-facing API base path. Keep /api when Vite or a reverse proxy forwards requests.
VITE_API_URL=/api

# Local Vite development server.
VITE_DEV_HOST=localhost
VITE_DEV_PORT=3000
VITE_API_PROXY_TARGET=http://localhost:8089

# User-interface timing values in milliseconds.
VITE_API_TIMEOUT_MS=15000
VITE_TOAST_DURATION_MS=3000
